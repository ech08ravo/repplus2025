# Copy this file to .env and fill in real values. The .env file is
# gitignored and is read automatically by docker compose at startup.
# Never commit .env itself.

# Anthropic API key for the in-app "Ask Claude (API)" chat buttons.
# Get one from https://console.anthropic.com/settings/keys
# Without this, the chat buttons stay hidden and only the
# Copy-to-Clipboard fallback is available.
ANTHROPIC_API_KEY=
